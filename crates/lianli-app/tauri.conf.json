{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "RGBable",
  "version": "1.1.0",
  "identifier": "com.boywholifts.rgbable",
  "build": {
    "frontendDist": "ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "RGBable",
        "width": 1180,
        "height": 760,
        "minWidth": 900,
        "minHeight": 600,
        "resizable": true,
        "visible": false,
        "dragDropEnabled": false,
        "backgroundColor": "#0b0910",
        "additionalBrowserArgs": "--disable-features=msWebOOUI,msPdfOOUI,msSmartScreenProtection,CalculateNativeWinOcclusion --disable-direct-composition-video-overlays"
      }
    ],
    "security": { "csp": null, "assetProtocol": { "enable": true, "scope": [] } }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "publisher": "boywholifts",
    "homepage": "https://github.com/boywholifts/rgbable",
    "shortDescription": "Open-source lighting and OLED control for Lian Li hardware",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/icon.png", "icons/icon.ico"],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "installerIcon": "icons/icon.ico"
      }
    }
  }
}
